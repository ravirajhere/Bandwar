# ═══════════════════════════════════════════════════════════════════
# BANDWAR — .gitattributes
# Normalize line endings across platforms
# ═══════════════════════════════════════════════════════════════════

# Auto-detect text files and normalize to LF in repo
* text=auto eol=lf

# ─── EXPLICIT TYPES ───
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.cjs        text eol=lf
*.mjs        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.xml        text eol=lf
*.svg        text eol=lf

# ─── BINARY FILES (never touch) ───
*.jpg        binary
*.jpeg       binary
*.png        binary
*.gif        binary
*.webp       binary
*.avif       binary
*.ico        binary
*.pdf        binary
*.woff       binary
*.woff2      binary
*.ttf        binary

# ─── DIFF BEHAVIOR ───
*.md         diff=markdown
*.json       diff=json

# ─── LINGUIST NOISE (GitHub stats) ───
package-lock.json   linguist-generated=true
dist/**             linguist-generated=true
docs/screenshots/** linguist-documentation=true