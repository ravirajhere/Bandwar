# ═══════════════════════════════════════════════════════════════════
# BANDWAR — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ─── BUILD OUTPUT ───
dist/
build/
.cache/

# ─── IMAGE PIPELINE ───
.image-cache.json

# Source-only folders (not for public deploy)
images/_source/
images/_draft/

# ─── NODE ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── ENV ───
.env
.env.local
.env.*.local
*.env

# ─── OS ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── EDITOR ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── LOGS ───
*.log
logs/

# ─── TEMP ───
*.tmp
*.bak
*.orig

# ─── VERCEL ───
.vercel/
.now/

# ─── TESTING ───
coverage/
.nyc_output/
